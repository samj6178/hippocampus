{
  "server": {
    "mcp_port": 3000,
    "grpc_port": 9090,
    "rest_port": 8080
  },
  "database": {
    "driver": "sqlite",
    "sqlite_path": "/data/hippocampus.db"
  },
  "openai": {
    "mode": "cloud",
    "api_key": "ollama",
    "base_url": "http://ollama:11434/v1",
    "model": "nomic-embed-text",
    "dimensions": 768,
    "max_batch": 32
  },
  "memory": {
    "working_memory_capacity": 50,
    "default_token_budget": 4096,
    "consolidation_interval": "6h",
    "decay_half_life_days": 7.0,
    "gate_threshold": 0.3,
    "embedding_cache_size": 10000
  },
  "llm": {
    "provider": "none"
  },
  "log": {
    "level": "info",
    "format": "text"
  }
}
